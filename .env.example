# Frontend (Vite) — chỉ biến công khai, tiền tố VITE_
VITE_HINT_API_PATH=/api/hint
VITE_AI_HINTS_ENABLED=true

# services/ai-hint — chạy local bằng AWS profile của bạn (aws sso login); production dùng IAM role của Lambda.
# Không có API key AI: Claude được gọi qua Amazon Bedrock.
AWS_PROFILE=lalacode-dev
AWS_REGION=ap-southeast-1
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-5-5
AI_HINTS_ENABLED=true
AI_MAX_TOKENS=400
HINT_LIMIT_PER_TOKEN_PER_DAY=5
HINT_GLOBAL_LIMIT_PER_DAY=3000
RATE_LIMIT_TABLE=lalacode-hint-limits
