# Frontend (Vite) — chỉ biến công khai, tiền tố VITE_
VITE_HINT_API_PATH=/api/hint
VITE_AI_HINTS_ENABLED=true

# services/ai-hint — chạy local; production lấy từ Secrets Manager / biến môi trường Lambda
ANTHROPIC_API_KEY=replace-me
AI_MODEL=claude-haiku-5-5
AI_HINTS_ENABLED=true
HINT_LIMIT_PER_TOKEN_PER_DAY=5
HINT_GLOBAL_LIMIT_PER_DAY=3000
RATE_LIMIT_TABLE=lalacode-hint-limits
